# Copy to .env for local development. Never commit real values.

# --- Core ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parley
# Comma-separated origins allowed to open WebSockets / call the API (your public https:// URL in production).
PUBLIC_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to true behind a reverse proxy / load balancer so client IPs are used for rate limiting.
TRUST_PROXY=false
# Serve the built web app from the API server (production / Docker).
SERVE_WEB=false

# --- AI provider (Google Cloud Speech-to-Text v2, Translation, Text-to-Speech) ---
# google | none
AI_PROVIDER=google
GOOGLE_CLOUD_PROJECT=your-project-id
# Paste the service-account key JSON on one line, or point GOOGLE_APPLICATION_CREDENTIALS at a key file.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_LOCATION=global
GOOGLE_STT_MODEL=long

# --- WebRTC ---
STUN_URLS=stun:stun.l.google.com:19302
# e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Same value as coturn's static-auth-secret.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Limits and retention ---
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_JOIN_PER_MIN=30
MAX_ROOM_DURATION_MINUTES=240
ROOM_RETENTION_DAYS=7
