# syntax=docker/dockerfile:1
# API + WebSocket image for the Vercel `server` service. The build context is the repository root
# (the service's `root` in vercel.json) because the server bundles packages/shared.
# The web app is served separately by the `web` service, so it is not built here.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci
COPY packages/shared packages/shared
COPY apps/server apps/server
COPY tsconfig.base.json ./
RUN npm run build -w @parley/server && npm prune --omit=dev

FROM node:22-bookworm-slim
# Vercel sends traffic to $PORT (80 unless PORT is set in the project's environment variables).
# The image defaults to 8080 so it can run as the unprivileged `node` user.
ENV NODE_ENV=production \
    SERVE_WEB=false \
    PORT=8080
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/server/package.json ./apps/server/package.json
COPY --from=build /app/apps/server/dist ./apps/server/dist
USER node
EXPOSE 8080
# Migrations run automatically at startup (guarded by an advisory lock, so concurrent instances are safe).
CMD ["node", "apps/server/dist/server.js"]
